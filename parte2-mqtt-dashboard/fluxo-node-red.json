    {
        "id": "83117c6d715b3ef8",
        "type": "function",
        "z": "2371989f86b7c08b",
        "name": "Verificar Alerta Cardíaco",
        "func": "\nconst valor = msg.payload?.bpm;\nconst bpm = Number(valor);\n\nif (\n    valor === undefined ||\n    valor === null ||\n    valor === \"\" ||\n    !Number.isFinite(bpm) ||\n    bpm <= 0\n) {\n    msg.payload = \"⚪ Sem leitura cardíaca válida\";\n} else if (bpm > 100) {\n    msg.payload = `🔴 ALERTA: Frequência cardíaca elevada (${bpm} BPM)`;\n} else if (bpm < 60) {\n    msg.payload = `⚠️ ALERTA: Frequência cardíaca baixa (${bpm} BPM)`;\n} else {\n    msg.payload = `✅ Frequência cardíaca dentro da faixa demonstrativa (${bpm} BPM)`;\n}\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 520,
        "wires": [
            [
                "6c2cc79b63477b3b"
            ]
        ]
    },
    {
        "id": "6c2cc79b63477b3b",
