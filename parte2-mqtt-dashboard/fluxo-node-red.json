    },
    {
        "id": "8ec961f7218c80b5",
        "type": "ui-template",
        "z": "2371989f86b7c08b",
        "group": "7d5a523d8ed9adb1",
        "page": "",
        "ui": "",
        "name": "CardioIA - Cards Personalizados",
        "order": 1,
        "width": "12",
        "height": "5",
        "head": "",
        "format": "\n<template>\n  <div class=\"cardio-grid\">\n\n    <div class=\"cardio-card\">\n      <div class=\"cardio-icon heart\">♥</div>\n      <div class=\"cardio-label\">Frequência Cardíaca</div>\n      <div class=\"cardio-value\">\n        {{ bpm }} <span>BPM</span>\n      </div>\n      <div class=\"cardio-status\"\n           :class=\"bpmStatus.className\">\n        {{ bpmStatus.label }}\n      </div>\n    </div>\n\n    <div class=\"cardio-card\">\n      <div class=\"cardio-icon temp\">🌡</div>\n      <div class=\"cardio-label\">Temperatura Ambiente</div>\n      <div class=\"cardio-value\">\n        {{ temperatura }} <span>°C</span>\n      </div>\n      <div class=\"cardio-status normal\">\n        Leitura ambiental\n      </div>\n    </div>\n\n    <div class=\"cardio-card\">\n      <div class=\"cardio-icon humidity\">💧</div>\n      <div class=\"cardio-label\">Umidade Ambiente</div>\n      <div class=\"cardio-value\">\n        {{ umidade }} <span>%</span>\n      </div>\n      <div class=\"cardio-status normal\">\n        Leitura ambiental\n      </div>\n    </div>\n\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    bpm() {\n      return this.msg?.payload?.bpm ?? '--'\n    },\n    temperatura() {\n      return this.msg?.payload?.temperatura ?? '--'\n    },\n    umidade() {\n      return this.msg?.payload?.umidade ?? '--'\n    },\n    bpmStatus() {\n      const bpm = Number(this.msg?.payload?.bpm)\n      if (this.msg?.payload?.bpm == null || !Number.isFinite(bpm)) {\n        return { label: 'Aguardando dados', className: 'waiting' }\n      }\n      if (bpm < 60) {\n        return { label: '⚠ Frequência baixa', className: 'danger' }\n      }\n      if (bpm > 100) {\n        return { label: '⚠ Frequência elevada', className: 'danger' }\n      }\n      return { label: '✓ Faixa de referência', className: 'normal' }\n    }\n  }\n}\n</script>\n\n<style>\n.cardio-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 18px;\n  padding: 12px;\n  width: 100%;\n}\n\n.cardio-card {\n  background: #ffffff;\n  border: 1px solid #e8edf4;\n  border-radius: 18px;\n  padding: 26px 18px;\n  box-shadow: 0 5px 18px rgba(15, 23, 42, 0.06);\n  text-align: left;\n  min-width: 0;\n}\n\n.cardio-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 46px;\n  height: 46px;\n  border-radius: 13px;\n  font-size: 25px;\n  margin-bottom: 20px;\n}\n\n.heart {\n  background: #fee2e2;\n  color: #dc2626;\n}\n\n.temp {\n  background: #dcfce7;\n  color: #15803d;\n}\n\n.humidity {\n  background: #dbeafe;\n  color: #2563eb;\n}\n\n.cardio-label {\n  font-size: 14px;\n  color: #64748b;\n  font-weight: 600;\n}\n\n.cardio-value {\n  font-size: 42px;\n  font-weight: 800;\n  color: #0f172a;\n  margin: 12px 0 18px;\n}\n\n.cardio-value span {\n  font-size: 15px;\n  font-weight: 500;\n  color: #64748b;\n}\n\n.cardio-status {\n  display: inline-block;\n  padding: 7px 12px;\n  border-radius: 20px;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.cardio-status.normal {\n  background: #dcfce7;\n  color: #166534;\n}\n\n.cardio-status.danger {\n  background: #fee2e2;\n  color: #b91c1c;\n}\n\n.cardio-status.waiting {\n  background: #f1f5f9;\n  color: #64748b;\n}\n\n@media (max-width: 700px) {\n  .cardio-grid {\n    grid-template-columns: 1fr;\n  }\n}\n</style>\n",
        "noerr": 0,
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 610,
